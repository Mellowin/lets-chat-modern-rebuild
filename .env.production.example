# Example production environment file for docker-compose.prod.yml.
# Copy this file to .env.production, fill in real values, and keep it secret.
# .env.production is gitignored and must never be committed.

# ==========================================
# Server / Caddy
# ==========================================
API_DOMAIN=api.example.com
TLS_MODE=on
ACME_EMAIL=admin@example.com

# ==========================================
# PostgreSQL (Docker service)
# ==========================================
POSTGRES_USER=letschat
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=letschat_production

# Connection string used by the API. Host name must match the Compose service.
DATABASE_URL=postgresql://letschat:change-me-to-a-strong-random-password@postgres:5432/letschat_production?schema=public

# ==========================================
# Redis (Docker service)
# ==========================================
REDIS_URL=redis://redis:6379

# Optional: enable Redis-backed Socket.io adapter for multi-instance deployments.
# WEBSOCKET_REDIS_URL=redis://redis:6379

# Optional: enable Redis-backed presence store for multi-instance deployments.
# PRESENCE_REDIS_URL=redis://redis:6379

# ==========================================
# Auth
# ==========================================
BCRYPT_SALT_ROUNDS=12

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-min-32-characters-long
JWT_REFRESH_SECRET=change-me-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# S3 / Cloudflare R2
# ==========================================
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_BUCKET=letschat-uploads
S3_FORCE_PATH_STYLE=false

# ==========================================
# API
# ==========================================
PORT=3001

# Comma-separated allowed CORS origins. Must use https:// in production.
CORS_ORIGIN=https://app.example.com

# Public web URL. Must use https://.
APP_WEB_URL=https://app.example.com

# Only set to true if you explicitly need localhost origins in production.
# CORS_ALLOW_LOCALHOST_IN_PRODUCTION=false

# ==========================================
# Rate limiting
# ==========================================
THROTTLER_ENABLED=true
THROTTLER_TTL_MS=60000
THROTTLER_LIMIT=100

# ==========================================
# Mail
# ==========================================
MAIL_PROVIDER=resend
MAIL_FROM=noreply@example.com
RESEND_API_KEY=re_xxxxxxxx

# Optional: SMTP fallback when Resend returns a temporary error.
# MAIL_FALLBACK_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@example.com

# ==========================================
# Web Push (optional)
# ==========================================
# Generate keys with: pnpm --filter api push:generate-vapid-keys
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_SUBJECT=https://app.example.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key

# ==========================================
# Demo mode (disabled by default)
# ==========================================
DEMO_MODE_ENABLED=false
DEMO_SESSION_TTL_HOURS=24
DEMO_RATE_LIMIT_PER_HOUR=10
